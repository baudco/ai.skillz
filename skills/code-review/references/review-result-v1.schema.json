{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code review result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "repository",
    "scope",
    "findings",
    "checks",
    "open_questions",
    "residual_risks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "base", "merge_base", "head", "paths"],
      "properties": {
        "target": {
          "enum": ["worktree", "staged", "commit", "range", "branch"]
        },
        "base": {
          "type": ["string", "null"]
        },
        "merge_base": {
          "type": ["string", "null"]
        },
        "head": {
          "type": ["string", "null"]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_generated_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "severity",
        "confidence",
        "category",
        "path",
        "start_line",
        "end_line",
        "symbol",
        "title",
        "evidence",
        "impact",
        "recommendation"
      ],
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "severity": {
          "enum": ["P0", "P1", "P2", "P3"]
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        },
        "category": {
          "enum": [
            "api",
            "concurrency",
            "correctness",
            "data-loss",
            "maintainability",
            "performance",
            "reliability",
            "security",
            "tests"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "end_line": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "summary"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "delegated",
            "unavailable",
            "error"
          ]
        },
        "command": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
